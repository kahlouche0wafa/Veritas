# VERITAS environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ---- Nokia Network as Code (CAMARA) ----
# The apihub.nokia.io RapidAPI-backed gateway serves the CAMARA simulator.
# Region-pinned host (Sept 2026 verified):
NOKIA_BASE_URL=https://network-as-code.p-eu.apihub.nokia.io
NOKIA_API_KEY=your_rapidapi_key_here

# Auth is two headers together on this gateway. `x-rapidapi-key` carries
# the key; `x-rapidapi-host` is a distinct host string (NOT the same as
# the base URL host) that Nokia's routing expects.
NOKIA_AUTH_HEADER=x-rapidapi-key
NOKIA_RAPIDAPI_HOST=network-as-code.nokia.rapidapi.com

# KYC Tenure's checkTenure endpoint compares against a reference date:
# tenureDate = today - NOKIA_TENURE_LOOKBACK_DAYS. Default 1 year, so
# tenureDateCheck=true means "SIM has been active at least a year."
NOKIA_TENURE_LOOKBACK_DAYS=365

# ---- Supabase ----
# From: Supabase Project Settings → API. The service-role key bypasses RLS;
# only use it in trusted server processes.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# ---- Groq (LLM: normalise + rationale) ----
# One key is enough; the code rotates automatically through numbered keys
# GROQ_API_KEY_1 .. GROQ_API_KEY_N on rate-limit errors.
GROQ_API_KEY_1=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ---- Runtime toggles ----
# CAMARA_MODE: 'auto' (live if NOKIA_* set, else scripted),
#              'live', or 'scripted' (force one).
CAMARA_MODE=live
